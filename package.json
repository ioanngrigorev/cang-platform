{
  "name": "cang-platform",
  "version": "0.1.0",
  "private": true,
  "description": "CANG \u2014 Vietnam-first global B2B industrial marketplace (cang.vn)",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:reset": "tsx src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "setup": "pnpm install && pnpm db:migrate && pnpm db:seed",
    "test:e2e": "node e2e/cjm-journey.mjs",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "test:links": "node e2e/link-audit.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@hookform/resolvers": "3.10.0",
    "@paralleldrive/cuid2": "3.3.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.1",
    "drizzle-orm": "0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "1.47.0",
    "marked": "^18.0.13",
    "next": "15.5.25",
    "next-intl": "4.14.5",
    "nodemailer": "^10.0.12",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.25",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "10.6.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@10.34.6"
}
