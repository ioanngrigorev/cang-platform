// =====================================================================
// CANG — Vietnam-first global B2B industrial marketplace (cang.vn)
// Relational schema (PostgreSQL / Prisma)
//
// Conventions
//  - ids: cuid strings
//  - money: Decimal(18,4) + ISO currency code column
//  - localized catalog text: `name` (en) + `nameVi` (vi); more locales via *Translation tables later
//  - soft deletion: `deletedAt` on user-generated entities
//  - configurable-by-admin sets live in tables (OrderStatus, Badge, FeeRule, Plan, ...)
//    inherent sets live in enums (PaymentStatus, RFQStatus, ...)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

