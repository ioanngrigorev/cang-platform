# --- Core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cang?schema=public"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
NODE_ENV="development"

# --- Auth providers (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OTP_PROVIDER="console"        # console | twilio (later)

# --- Infrastructure (optional; in-memory fallbacks are used when empty) ---
REDIS_URL=""
STORAGE_PROVIDER="local"      # local | s3
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
CDN_URL=""
SEARCH_PROVIDER="postgres"    # postgres | opensearch
OPENSEARCH_URL=""
EMAIL_PROVIDER="console"      # console | smtp | resend
SMTP_URL=""
EMAIL_FROM="CANG <no-reply@cang.vn>"

# --- Seed ---
SEED_ADMIN_EMAIL="admin@cang.vn"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_DEMO_PASSWORD="Password123!"

# --- Production seeding ---
# false → seed only reference data, platform configuration and the admin account
# (no demo companies, products, RFQs or orders). Always false in production.
SEED_DEMO_DATA="true"

# --- Search engines (optional) ---
# Search Console "HTML tag" token (the content="" value only) and Bing Webmaster token.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# --- Logistics tracking sync (optional) ---
# Protects /api/logistics/sync, which pulls GHN / GHTK statuses for shipments that have a tracking
# number. Call it from cron every 30–60 min:
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://cang.vn/api/logistics/sync
# Carriers can also push updates to the webhook URL shown in each partner's Integrations page.
CRON_SECRET=""
