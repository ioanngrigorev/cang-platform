# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
dist
tsconfig.tsbuildinfo

# Local state and secrets — never bake these into an image
.env
.env.*
!.env.example
storage
playwright-report
test-results
tmp
*.log

# Tooling and docs that the image does not need
.git
.gitignore
.github
.vscode
.idea
.claude
docs
e2e
README.md
deploy/README.md
deploy/backup.sh
deploy/Caddyfile
docker-compose*.yml
Dockerfile
.DS_Store
